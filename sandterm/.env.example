# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Default provider: local | daytona | e2b
SANDTERM_PROVIDER=local

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://api.daytona.io

# E2B (https://e2b.dev)
E2B_API_KEY=

# AI - At least one required for AI features
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Provider: anthropic | openai
DEFAULT_AI_PROVIDER=anthropic

# Features
ENABLE_AI=true
ENABLE_AUTO_FIX=true
ENABLE_COMMAND_ANALYSIS=true
