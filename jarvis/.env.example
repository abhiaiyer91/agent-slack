# =============================================================================
# Jarvis — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# --- LLM Providers (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Voice Providers ---
# OpenAI TTS/STT (uses OPENAI_API_KEY above)
# ElevenLabs (high-quality voice synthesis)
ELEVENLABS_API_KEY=
# Deepgram (fast transcription)
DEEPGRAM_API_KEY=

# --- Integrations ---
# GitHub MCP
GITHUB_TOKEN=

# --- Storage ---
# LibSQL (default: local file)
DATABASE_URL=file:./jarvis.db
