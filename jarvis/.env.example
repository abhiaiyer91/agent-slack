# =============================================================================
# Jarvis — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# --- LLM Providers (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Web Search ---
TAVILY_API_KEY=

# --- Voice Providers ---
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- MCP Integrations ---
GITHUB_TOKEN=

# --- Channel Integrations ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=

# --- Channel Delivery Targets (for webhooks + scheduler) ---
JARVIS_SLACK_CHANNEL=
JARVIS_DISCORD_CHANNEL=

# --- Webhook Security ---
JARVIS_WEBHOOK_SECRET=

# --- Storage ---
DATABASE_URL=file:./jarvis.db

# --- Workspace ---
JARVIS_WORKSPACE=./workspace
