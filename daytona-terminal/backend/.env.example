# Daytona Terminal Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Daytona Terminal
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Daytona Configuration
# =============================================================================
# Get your API key from https://app.daytona.io
DAYTONA_API_URL=https://api.daytona.io
DAYTONA_API_KEY=

# Default workspace settings
DAYTONA_DEFAULT_IMAGE=daytonaio/workspace:latest
DAYTONA_WORKSPACE_TIMEOUT=3600

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./daytona_terminal.db

# =============================================================================
# Authentication
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# AI Integrations
# =============================================================================
# Anthropic Claude - Get key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI - Get key from https://platform.openai.com
OPENAI_API_KEY=

# =============================================================================
# Terminal Settings
# =============================================================================
TERMINAL_DEFAULT_SHELL=/bin/bash
TERMINAL_DEFAULT_COLS=120
TERMINAL_DEFAULT_ROWS=40
TERMINAL_SCROLLBACK=10000

# =============================================================================
# WebSocket Settings
# =============================================================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576
