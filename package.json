{
  "name": "agent-slack",
  "version": "0.1.0",
  "description": "Slack-like communication primitives for AI agents, built with Mastra",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "example:code-review": "tsx examples/code-review.ts",
    "example:incident": "tsx examples/incident-response.ts",
    "example:research": "tsx examples/research-collaboration.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "mastra",
    "slack",
    "collaboration",
    "multi-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@mastra/core": "^0.10.0",
    "zod": "^3.24.0",
    "nanoid": "^5.1.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "eslint": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
